# TRENDSPARK AI Configuration Template
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./backend/data/trendspark.db

# Optional External AI Providers (If empty, TrendSpark uses built-in Agentic Creative Engine)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Default Region & Niche Preferences
DEFAULT_REGION=VN
DEFAULT_NICHE=Technology
TREND_CACHE_TTL_MINUTES=30
